{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:egr:schema:delegation-contract:1.0.0",
  "title": "Evidence-Grounded Delegation Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "routing_decision_id",
    "agent_id",
    "objective",
    "acceptance_criteria",
    "authorized_tools",
    "prohibited_actions",
    "output_schema_ref",
    "timeout_seconds",
    "max_retries",
    "policy_bundle_version",
    "created_at"
  ],
  "properties": {
    "contract_id": { "type": "string", "minLength": 1 },
    "routing_decision_id": { "type": "string", "minLength": 1 },
    "agent_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "authorized_tools": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "prohibited_actions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "output_schema_ref": { "type": ["string", "null"] },
    "timeout_seconds": { "type": "integer", "minimum": 1 },
    "max_retries": { "type": "integer", "minimum": 0 },
    "policy_bundle_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
